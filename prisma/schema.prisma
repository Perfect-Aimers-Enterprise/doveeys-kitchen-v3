generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  OWNER
  ADMIN
}

enum MealType {
  NORMAL
  SPECIAL
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum ReportKind {
  WEEKLY
  MONTHLY
}

enum ReportStatus {
  GENERATING
  SENT
  FAILED
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  statusChanges  OrderStatusHistory[]
  auditLogs      AdminAuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime

  @@index([resetAt])
}

model MealCategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  meals Meal[]
}

model Meal {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  description   String
  ingredients   String?
  type          MealType  @default(NORMAL)
  basePrice     Decimal?  @db.Decimal(12, 2)
  imageUrl      String?
  imagePublicId String?
  categoryId    String?
  isAvailable   Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  sortOrder     Int       @default(0)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category   MealCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options    SpecialMealOption[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isAvailable, archivedAt])
  @@index([isFeatured])
}

model SpecialMealOption {
  id        String  @id @default(cuid())
  mealId    String
  litres    Decimal @db.Decimal(6, 2)
  price     Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  meal       Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([mealId, litres])
  @@index([mealId])
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String   @unique
  fee       Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Order {
  id                String        @id @default(cuid())
  reference         String        @unique
  customerName      String
  customerEmail     String
  customerPhone     String
  deliveryAddress   String
  deliveryNotes     String?
  deliveryZoneId    String?
  deliveryZoneName  String?
  subtotal          Decimal       @db.Decimal(12, 2)
  deliveryFee       Decimal       @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  paymentStatus     PaymentStatus @default(PENDING)
  status            OrderStatus   @default(PENDING_PAYMENT)
  trackingTokenHash String?       @unique
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  zone    DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?
  history OrderStatusHistory[]
  emails  EmailLog[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerEmail])
  @@index([createdAt])
}

// Immutable snapshot of what was bought, so later meal edits never alter history.
model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  mealId          String?
  optionId        String?
  mealName        String
  mealDescription String?
  mealType        MealType
  litres          Decimal? @db.Decimal(6, 2)
  unitPrice       Decimal  @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal  @db.Decimal(12, 2)

  order  Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  meal   Meal?              @relation(fields: [mealId], references: [id], onDelete: SetNull)
  option SpecialMealOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([mealId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  paystackReference String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  refundedAmount    Decimal       @default(0) @db.Decimal(12, 2)
  channel           String?
  rawVerification   Json?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Idempotency ledger for Paystack webhooks.
model WebhookEvent {
  id          String    @id @default(cuid())
  eventKey    String    @unique
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  adminId    String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model EmailLog {
  id        String      @id @default(cuid())
  to        String
  template  String
  subject   String
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  error     String?
  bodyHtml  String?     @db.Text
  bodyText  String?     @db.Text
  orderId   String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
}

model ReportLog {
  id          String       @id @default(cuid())
  kind        ReportKind
  periodStart DateTime
  periodEnd   DateTime
  status      ReportStatus @default(GENERATING)
  sentTo      String?
  error       String?
  createdAt   DateTime     @default(now())
  sentAt      DateTime?

  @@unique([kind, periodStart])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([entity, entityId])
}
